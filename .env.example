# Separate multiple roots with ':' on macOS/Linux or ';' on Windows.
# Read roots apply only to list/find/search/read operations.
CHATWORK_READ_ROOTS=/Users/you/Projects
# Write roots also bound command working directories and long-running jobs.
CHATWORK_ROOTS=/Users/you/Projects
CHATWORK_HOST=127.0.0.1
CHATWORK_PORT=7337

# Optional for local HTTP clients that can send a Bearer token.
# Secure MCP Tunnel authenticates its own transport and can use stdio instead.
CHATWORK_TOKEN=

# Optional output limits.
CHATWORK_MAX_READ_BYTES=1000000
CHATWORK_MAX_WRITE_BYTES=5000000
CHATWORK_MAX_IMAGE_BYTES=12000000
CHATWORK_MAX_OUTPUT_BYTES=200000
# Hard-capped at 90 seconds to remain below the Secure MCP Tunnel response
# deadline. Use start_job for anything longer.
CHATWORK_MAX_COMMAND_SECONDS=90
CHATWORK_MAX_SEARCH_RESULTS=300
# Maximum directory entries inspected by find_files/search_text before they
# return scan_entry_limit. Result limits are reported separately.
CHATWORK_MAX_SCAN_ENTRIES=50000
CHATWORK_MAX_BATCH_FILES=20
CHATWORK_MAX_PATCH_BYTES=1000000
CHATWORK_IO_TIMEOUT_MS=15000
CHATWORK_MAX_CONCURRENT_JOBS=8
CHATWORK_MAX_JOB_LOG_BYTES=100000000
CHATWORK_MAX_AUDIT_LOG_BYTES=20000000

# Fail closed if macOS process sandboxing is unavailable. Recommended for the
# ChatGPT tunnel runtime; leave false only for platforms without sandbox-exec.
CHATWORK_REQUIRE_PROCESS_SANDBOX=false

# Explicit escape hatch for commands that genuinely need SSH/cloud/browser
# credentials. Keep false for normal Chat use; dedicated file tools always deny.
CHATWORK_ALLOW_SENSITIVE_COMMAND_READS=false
